# Preenchido pelo CDK em produção. Local, só para exercitar os adapters AWS
# contra DynamoDB Local / LocalStack.
TABLE_NAME=job-radar-local
RAW_BUCKET=job-radar-raw-local
FETCH_QUEUE_URL=http://localhost:4566/000000000000/fetch-queue
NORMALIZE_QUEUE_URL=http://localhost:4566/000000000000/normalize-queue

LOG_LEVEL=info
HTTP_TIMEOUT_MS=15000

# Identificar o bot dá à fonte um jeito de pedir para parar em vez de bloquear.
USER_AGENT=job-radar/0.1 (+https://github.com/mpgxc/job-radar)

AWS_REGION=us-east-1
